<Page x:Class="PD2Launcherv2.Views.FiltersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PD2Launcherv2.ViewModels"
      xmlns:converters="clr-namespace:PD2Launcherv2.Converters"
      Width="750" Height="550"
      mc:Ignorable="d" 
      Title="FiltersView"
      Loaded="FiltersView_Loaded"
      DataContext="{Binding FiltersViewModel, Source={StaticResource ViewModelLocator}}">

    <Page.Resources>
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Item builder -->
        <Style x:Key="BuilderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftWhite}"/>
            <Setter Property="FontFamily" Value="{StaticResource BlizzLight}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,5,0"/>
        </Style>
        <Style x:Key="BuilderCombo" TargetType="ComboBox" BasedOn="{StaticResource CustomComboBoxStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource BlizzMedium}"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same look, but typed into: the base search (type the start of a name). -->
        <Style x:Key="BuilderEditableCombo" TargetType="ComboBox" BasedOn="{StaticResource BuilderCombo}">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <TextBox x:Name="PART_EditableTextBox" Margin="4,0,20,0" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{StaticResource GoldBrush}" FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"/>
                            <ToggleButton HorizontalAlignment="Right" Width="20" Focusable="False" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource GoldBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="Black" BorderThickness="1" BorderBrush="{StaticResource GoldBrush}"/>
                                    <ScrollViewer Margin="4" CanContentScroll="True">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomVerticalScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small square -/+ buttons for number inputs. -->
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BlizzHeavy}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Black" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33A78E65"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldLighterBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewNumberBox" TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource SoftWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BlizzLight}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="BuilderCheck" TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
            <Setter Property="Foreground" Value="{StaticResource SoftWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource BlizzLight}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Image Source="pack://application:,,,/Resources/Images/bg_plain.jpg" Stretch="Fill"/>

        <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" FontFamily="{StaticResource BlizzHeavy}" Command="{Binding CloseCommand}" 
            FontSize="25" Content="X" />
        <TextBlock x:Name="Filter" Text="Filters" FontSize="25" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                   Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource BlizzHeavy}">
        </TextBlock>
        <Button Content="Help"
                Style="{StaticResource CustomColorChangeButton}"
                Command="{Binding OpenHelpPageCommand}"
                FontFamily="{StaticResource BlizzMedium}"
                FocusVisualStyle="{x:Null}"
                FontSize="12"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="180,30,0,0"/>

        <!-- Author List-->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,70,0,0">
            <TextBlock Text="Author" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldBrush}"/>
            <ListBox x:Name="AuthorsListBox"
                     ItemsSource="{Binding AuthorsList}"
                     ItemContainerStyle="{StaticResource CustomListBoxItemStyle}"
                     FontFamily="{StaticResource BlizzMedium}"
                     FontSize="18"
                     DisplayMemberPath="Author"
                     Background="Black"
                     BorderBrush="{StaticResource GoldBrush}"
                     BorderThickness="2"
                     Height="400" Width="200"
                     SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}"
                     FocusVisualStyle="{x:Null}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomVerticalScrollBar}"/>
                </ListBox.Resources>
            </ListBox>
        </StackPanel>

        <!-- Filter List-->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,70,0,0">
            <TextBlock Text="{Binding SelectedAuthor.Name}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="{StaticResource BlizzMedium}" Foreground="{StaticResource GoldLighterBrush}"/>
            <ListBox x:Name="FiltersListBox"
                     ItemsSource="{Binding FiltersList}"
                     ItemContainerStyle="{StaticResource CustomListBoxItemStyle}"
                     FontFamily="{StaticResource BlizzLight}"
                     FontSize="16"
                     DisplayMemberPath="Name"
                     FocusVisualStyle="{x:Null}"
                     Background="Black"
                     BorderBrush="{StaticResource GoldBrush}"
                     BorderThickness="2"
                     Height="400" Width="300"
                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomVerticalScrollBar}"/>
                </ListBox.Resources>
            </ListBox>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,35,0">
            <Button Content="Save Filter"
                    Command="{Binding SaveFilterCommand}"
                    FontFamily="{StaticResource BlizzMedium}"
                    FocusVisualStyle="{x:Null}"
                    FontSize="18"
                    Margin="0,0,0,50"
                    IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CustomColorChangeButton}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="Gray"/>
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Authors Page"
                    Style="{StaticResource CustomColorChangeButton}"
                    Command="{Binding OpenAuthorsPageCommand}"
                    FontFamily="{StaticResource BlizzMedium}"
                    FocusVisualStyle="{x:Null}"
                    FontSize="18"
                    Margin="0,0,0,50"
                    />

            <Button Content="Preview Filter"
                    Command="{Binding OpenFilterPreviewCommand}"
                    FontFamily="{StaticResource BlizzMedium}"
                    FocusVisualStyle="{x:Null}"
                    FontSize="18"
                    Margin="0,0,0,50"
                    IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CustomColorChangeButton}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="Gray"/>
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Copy to Local"
                    Command="{Binding CopyToLocalCommand}"
                    FontFamily="{StaticResource BlizzMedium}"
                    FocusVisualStyle="{x:Null}"
                    FontSize="18"
                    Margin="0,0,0,50"
                    ToolTip="Copy this filter to local storage. Note: Local filters will not receive automatic updates."
                    IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CustomColorChangeButton}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="Gray"/>
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Close Preview"
                    Style="{StaticResource CustomColorChangeButton}"
                    Command="{Binding CloseFilterPreviewCommand}"
                    FontFamily="{StaticResource BlizzMedium}"
                    FocusVisualStyle="{x:Null}"
                    FontSize="18"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,0"/>
        </StackPanel>

        <!-- Filter preview: every name and description here comes from the installed BH.dll,
             run against a simulated game by BHPreviewHost.exe. -->
        <Grid Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="pack://application:,,,/Resources/Images/bg_plain.jpg" Stretch="Fill"/>
            <DockPanel Margin="20,10,20,15">
                <TextBlock DockPanel.Dock="Top" Text="Filter Preview" FontSize="24" FontFamily="{StaticResource BlizzHeavy}"
                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                    <TextBlock Text="Character level" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource SoftWhite}" FontFamily="{StaticResource BlizzLight}" FontSize="12"/>
                    <TextBox Text="{Binding PreviewCharacterLevel, UpdateSourceTrigger=PropertyChanged}" Width="36"
                             Style="{StaticResource PreviewNumberBox}"/>
                    <TextBlock Text="Difficulty" VerticalAlignment="Center" Margin="14,0,6,0"
                               Foreground="{StaticResource SoftWhite}" FontFamily="{StaticResource BlizzLight}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding PreviewDifficulties}" SelectedIndex="{Binding PreviewDifficulty}"
                              Style="{StaticResource CustomComboBoxStyle}" Width="100" Margin="0" Padding="6,0,0,0"
                              FontSize="12" Background="Black" VerticalAlignment="Center"/>
                    <TextBlock Text="Filter level" VerticalAlignment="Center" Margin="14,0,6,0"
                               ToolTip="The BH filter level to preview, 0-15."
                               Foreground="{StaticResource SoftWhite}" FontFamily="{StaticResource BlizzLight}" FontSize="12"/>
                    <Button Content="-" Style="{StaticResource StepperButton}" Command="{Binding DecreaseFilterLevelCommand}"/>
                    <TextBox Text="{Binding PreviewFilterLevel, UpdateSourceTrigger=PropertyChanged}" Width="28" Margin="3,0"
                             Style="{StaticResource PreviewNumberBox}"/>
                    <Button Content="+" Style="{StaticResource StepperButton}" Command="{Binding IncreaseFilterLevelCommand}"/>
                    <CheckBox Content="Show hidden" IsChecked="{Binding ShowHiddenItems}" Style="{StaticResource BuilderCheck}" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- Build any item to check against the filter. The builder takes room from the
                     list while it is open. -->
                <Button DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,8"
                        Style="{StaticResource CustomColorChangeButton}" Command="{Binding ToggleItemBuilderCommand}"
                        FontFamily="{StaticResource BlizzMedium}" FocusVisualStyle="{x:Null}" FontSize="12">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Build an item"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItemBuilderOpen}" Value="True">
                                            <Setter Property="Text" Value="Hide item builder"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>

                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6" Background="#E6000000"
                        BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                        DataContext="{Binding ItemBuilder}"
                        Visibility="{Binding DataContext.IsItemBuilderOpen, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Base" Style="{StaticResource BuilderLabel}" Margin="0,0,5,0"/>
                            <ComboBox Style="{StaticResource BuilderEditableCombo}" Width="230"
                                      ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}"
                                      DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"/>
                            <TextBlock Text="Rarity" Style="{StaticResource BuilderLabel}"/>
                            <ComboBox Style="{StaticResource BuilderCombo}" Width="90"
                                      ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}"/>
                            <ComboBox Style="{StaticResource BuilderCombo}" Width="200" Margin="8,0,0,0"
                                      ItemsSource="{Binding NamedChoices}" SelectedItem="{Binding SelectedNamed}" DisplayMemberPath="Name"
                                      Visibility="{Binding HasNamedChoice, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="Item level" Style="{StaticResource BuilderLabel}" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding ItemLevel, UpdateSourceTrigger=PropertyChanged}" Width="34"
                                     Style="{StaticResource PreviewNumberBox}"/>
                            <TextBlock Text="Sockets" Style="{StaticResource BuilderLabel}"/>
                            <ComboBox Style="{StaticResource BuilderCombo}" Width="46"
                                      ItemsSource="{Binding SocketChoices}" SelectedItem="{Binding Sockets}"/>
                            <CheckBox Content="Identified" IsChecked="{Binding Identified}" Style="{StaticResource BuilderCheck}"/>
                            <CheckBox Content="Ethereal" IsChecked="{Binding Ethereal}" Style="{StaticResource BuilderCheck}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2"
                                    Visibility="{Binding HasAutoMods, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Auto mod" Style="{StaticResource BuilderLabel}" Margin="0,0,5,0"/>
                            <ComboBox Style="{StaticResource BuilderCombo}" Width="280"
                                      ItemsSource="{Binding AutoModChoices}" SelectedItem="{Binding SelectedAutoMod}" DisplayMemberPath="Text"/>
                            <TextBlock Text="Roll" Style="{StaticResource BuilderLabel}"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding AutoModRoll}" Width="90" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="5"/>
                            <TextBlock Text="{Binding RolledAutoModText}" Style="{StaticResource BuilderLabel}"
                                       Foreground="{StaticResource GoldBrush}" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RolledAutoModText}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasStaffMods, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBlock Text="Staff mods" Style="{StaticResource BuilderLabel}" Margin="0,0,5,0"/>
                                <ComboBox Style="{StaticResource BuilderCombo}" Width="40"
                                          ItemsSource="{Binding Bonuses}" SelectedItem="{Binding ClassSkills}"/>
                                <TextBlock Text="{Binding ClassSkillsText}" Style="{StaticResource BuilderLabel}" Margin="5,0,0,0"/>
                                <ComboBox Style="{StaticResource BuilderCombo}" Width="40" Margin="14,0,0,0"
                                          ItemsSource="{Binding Bonuses}" SelectedItem="{Binding TabBonus}"/>
                                <ComboBox Style="{StaticResource BuilderCombo}" Width="230" Margin="5,0,0,0"
                                          ItemsSource="{Binding TabChoices}" SelectedItem="{Binding Tab}" DisplayMemberPath="Text"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SkillSlots}" Margin="0,4,0,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                            <ComboBox Style="{StaticResource BuilderCombo}" Width="40"
                                                      ItemsSource="{Binding DataContext.Bonuses, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Bonus}"/>
                                            <ComboBox Style="{StaticResource BuilderCombo}" Width="150" Margin="5,0,0,0"
                                                      ItemsSource="{Binding DataContext.SkillChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Skill}" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Add to my list" Style="{StaticResource CustomColorChangeButton}"
                                    Command="{Binding DataContext.AddBuiltItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    ToolTip="Keep this item at the top of every filter preview."
                                    FontFamily="{StaticResource BlizzMedium}" FocusVisualStyle="{x:Null}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" Margin="0,0,110,0"
                               Visibility="{Binding IsPreviewIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{StaticResource SoftWhite}" FontFamily="{StaticResource BlizzLight}" FontSize="11"/>
                    <TextBlock Text="By HiimMark" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource BlizzMedium}" FontSize="12"/>
                </Grid>

                <Grid>
                <Border Background="Black" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomVerticalScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding PreviewRows}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <!-- Items the user built stand out. -->
                                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                        <Setter Property="Background" Value="#22A78E65"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                ToolTip="Remove from my list" Cursor="Hand" Margin="6,0,4,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemovePreviewItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                                                               FontSize="{TemplateBinding FontSize}" Foreground="{StaticResource GoldBrush}" Background="Transparent"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Icon" Property="Foreground" Value="IndianRed"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{Binding LabelBrush}" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" ToolTip="{Binding Description}" ToolTipService.IsEnabled="{Binding HasDescription}">
                                            <ItemsControl ItemsSource="{Binding NameLines}"
                                                          Visibility="{Binding Shown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl ItemsSource="{Binding}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                                               FontFamily="{StaticResource BlizzLight}" FontSize="13"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="hidden by filter" FontStyle="Italic" Foreground="#555555" FontSize="11"
                                                       Visibility="{Binding Hidden, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Error}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                    <!-- Shown while BH loads the filter or checks the items. -->
                    <Grid Background="#CC000000" Margin="2"
                          Visibility="{Binding IsPreviewBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                <Ellipse Stroke="#33A78E65" StrokeThickness="8"/>
                                <Ellipse Stroke="{StaticResource GoldBrush}" StrokeThickness="8"
                                         StrokeDashArray="7 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding PreviewStatus}" Margin="0,18,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource GoldBrush}" FontFamily="{StaticResource BlizzHeavy}" FontSize="22"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
            <Button Content="X" FontSize="30"
                    Style="{StaticResource CloseButtonStyle}" FontFamily="{StaticResource BlizzHeavy}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                    Background="Transparent" Foreground="{StaticResource GoldBrush}"
                    Width="50" Height="50"
                    Command="{Binding CloseFilterPreviewCommand}"
                    Panel.ZIndex="99"/>
        </Grid>
    </Grid>
</Page>